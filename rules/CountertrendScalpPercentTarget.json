{
    "name": "CountertrendScalpPercentTarget",
    "type": "Exit",
    "inputVariables": {
        "scalpPercent": "0.015"
    },
    "localVariables": {},
    "classMembersHook": "",
    "startOfFileHook": "",
    "preConditionHook": "",
    "longCondition": "el_gt(ctx.MarketPosition(), 0) && el_ge(close[0], ctx.EntryPrice() + scalpPercent * std::fabs(ctx.EntryPrice()))",
    "shortCondition": "el_lt(ctx.MarketPosition(), 0) && el_le(close[0], ctx.EntryPrice() - scalpPercent * std::fabs(ctx.EntryPrice()))",
    "postConditionHook": "",
    "endOfFileHook": ""
}
