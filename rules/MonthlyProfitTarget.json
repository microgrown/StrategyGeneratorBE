{
    "name": "MonthlyProfitTarget",
    "type": "Switch",
    "inputVariables": {
        "ProfitTarget": "5000"
    },
    "localVariables": {
        "CurrentEquity": {
            "type": "double",
            "init": "0.0"
        },
        "CurrentMonth": {
            "type": "int",
            "init": "0"
        },
        "MonthStartEquity": {
            "type": "double",
            "init": "0.0"
        },
        "PrevMonth": {
            "type": "int",
            "init": "0"
        },
        "PrevEquity": {
            "type": "double",
            "init": "0.0"
        }
    },
    "classMembersHook": "",
    "startOfFileHook": "",
    "preConditionHook": "CurrentEquity = ctx.NetProfit() + ctx.OpenPositionProfit();\nCurrentMonth = civil_from_days(day_of(ctx.Time(0))).month;\nif (CurrentMonth != PrevMonth) {\n    MonthStartEquity = PrevEquity;\n}",
    "longCondition": "CurrentEquity - MonthStartEquity > ProfitTarget",
    "shortCondition": "CurrentEquity - MonthStartEquity > ProfitTarget",
    "postConditionHook": "",
    "endOfFileHook": "PrevMonth = CurrentMonth;\nPrevEquity = CurrentEquity;"
}
