{
    "name": "PullbackReachesEntryPrice",
    "type": "Entry",
    "inputVariables": {
        "toleranceOffset": "0"
    },
    "localVariables": {},
    "classMembersHook": "",
    "startOfFileHook": "",
    "preConditionHook": "",
    "longCondition": "el_gt(ctx.MarketPosition(), 0) && el_le(low[0], ctx.EntryPrice() + toleranceOffset)",
    "shortCondition": "el_lt(ctx.MarketPosition(), 0) && el_ge(high[0], ctx.EntryPrice() - toleranceOffset)",
    "postConditionHook": "",
    "endOfFileHook": ""
}
