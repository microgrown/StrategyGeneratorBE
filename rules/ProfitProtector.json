    "longCondition": "maxPosProfit > maxProfit && ctx.OpenPositionProfit() < retracement * maxPosProfit",
    "shortCondition": "maxPosProfit > maxProfit && ctx.OpenPositionProfit() < retracement * maxPosProfit",
    "postConditionHook": "",
    "endOfFileHook": ""
}
